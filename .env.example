# Copy to .env and adjust. All values are optional.
SATSA_PORT=8080            # UI + API port on the host
SATSA_BIND=0.0.0.0         # set 127.0.0.1 to restrict to the local machine
SATSA_VERSION=1.0
SEED_DEMO=true             # seed the 20-entity synthetic dataset on first start
SOC_INSPECT_ENV=demo
DEMO_AUTH_DISABLED=true    # production: false, and set JWT_SECRET
JWT_SECRET=
CORS_ORIGINS=              # only needed if the UI is hosted on a different origin
POSTGRES_PASSWORD=change-me
